$mws_data_demo_rest $mws_data_book
	title \REST
	Datasource $mws_data_demo_rest_source
		columns <= fields_config
		- offset? <=> offset?
		- limit? <=> limit?
	fields_config /
		<= title_field *
			id \title
			title \Product Title
			field \title
			type \string
			hint \Enter product title
			rules /
				<= required_rule $mws_form_rules_required
			render_in_form true
			sortable true
		<= price_field *
			id \price
			title \Price
			field \price
			type \number
			hint \Enter price
			rules /
				<= required_rule $mws_form_rules_required
			render_in_form true
		<= stock_field *
			id \stock
			title \Stock
			field \stock
			type \number
			hint \Enter stock quantity
			rules /
				<= required_rule $mws_form_rules_required
			render_in_form true
		<= category_field *
			id \category
			title \Category
			field \category
			type \string
			hint \Enter category
			rules /
				<= required_rule $mws_form_rules_required
			render_in_form true
		<= actions_field *
			id \actions
			title \Actions
			field \actions
			type \actions
			renderer? <=> DefaultActions?
			render_in_form false
	-
	Details_body /
		<= Title $mol_labeler
			title <= title_label @ \Title
			content /
				<= details_entity_field*title
		<= Price $mol_labeler
			title <= price_label @ \Price
			content /
				<= details_entity_field*price
		<= Stock $mol_labeler
			title <= stock_label @ \Stock
			content /
				<= details_entity_field*stock
		<= Category $mol_labeler
			title <= category_label @ \Category
			content /
				<= details_entity_field*category
		<= Attributes $yuf_link
			title \Attributes
			param_name \app_data_entities_details_docs
			param_value \docs
	- spreads *
		docs <= Docs $mws_data_demo_memory
			title \Docs
			param_prefix \app_data_entities_details_docs
			param_base => docs_param_name
			param_suffix \docs
			addon_tools / ^ spread_close_content

