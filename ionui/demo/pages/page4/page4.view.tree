$mws_ionui_demo_pages_page4 $mws_ionui_component
	sub /
		<= IonHeader $mws_ionui_header
			sub /
				<= IonTollbar $mws_ionui_toolbar
					sub /
						<= IonButtons $mws_ionui_buttons
							attr *
								slot \start
							sub /
								<= IonMenuButton $mws_ionui_menubutton
						<= IonTitle $mws_ionui_title
							sub /
								<= Text \Foto feed
		<= IonContent $IC4
			sub /
				<= Refresher $mws_ionui_refresher
					event *
						ionRefresh?val <=> ionRefresh?val null
					attr *
						slot \fixed
						disabled <= getRefersherDisabled true
					sub /
						<= RefresherContent $mws_ionui_refreshercontent
				<= viewPort $mws_scroll_VirtualScrollViewport
					itemRendererFactory <= itemRendererFactory null
					itemHeight 600
					minBufferPx 2400
					maxBufferPx 4800
					style *
						height \100%
					pre_sub /
					post_sub /
						<= infspin $mws_ionui_spinner
							attr *
								slot \fixed
							style *
								width \100%
								height \32px
								margin-top \22px
								display <= getSpinnerDisplay \flex
$IC4 $mws_ionui_content
	attr *
		scroll-y \false
	classes /
		\ion-padding
