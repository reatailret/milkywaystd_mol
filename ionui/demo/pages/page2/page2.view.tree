$mws_ionui_demo_pages_page2 $mws_ionui_component
	sub /
		<= IonHeader $mws_ionui_header
			sub /
				<= IonTollbar $mws_ionui_toolbar
					sub /
						<= IonButtons $mws_ionui_buttons
							attr *
								slot \start
							sub /
								<= IonMenuButton $mws_ionui_menubutton
						<= IonTitle $mws_ionui_title
							sub /
								<= Text \Main
		<= IonContent $IC2
$IC2 $mws_ionui_content
	classes /
		\ion-padding
	sub /
		<= titleel $mws_ionui_title
			sub /
				<= text1 \Hello $mol!
