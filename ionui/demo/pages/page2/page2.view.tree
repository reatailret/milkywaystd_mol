$mws_ionui_demo_pages_page2 $mws_ionui_component
	sub /
		<= IonHeader $mws_ionui_header
			sub /
				<= IonTollbar $mws_ionui_toolbar
					sub /
						<= IonButtons $mws_ionui_buttons
							attr *
								slot \start
							sub /
								<= IonMenuButton22 $mws_ionui_menubutton
									attr *
										autohide \false
								<= IonMenuButton2 $mws_ionui_button
						<= IonTitle $mws_ionui_title
							sub /
								<= Text \Main
		<= IonContent $IC2
$IC2 $mws_ionui_content
	classes /
		\ion-padding
	sub /
		<= dbtn $mws_ionui_datetime_button
			attr *
				datetime \dt1
		<= mdl $mws_ionui_modal
			sub /
				<= dt $mws_ionui_datetime
					attr *
						id \dt1
