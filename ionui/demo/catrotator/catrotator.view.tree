$mws_ionui_demo_catrotator $mws_viewcontainer
	
	sub /
		<= IonCard $mws_ionui_card
			sub /
				<= IonImg $mws_ionui_img
					attr *
						src <= imgSrc null
				<= IonCardHeader $mws_ionui_cardheader
					sub /
						<= IonCardSubitle $mws_ionui_cardsubtitle
							sub /
								<= txt \Awesome images
				<= IonCardcontent $mws_ionui_cardcontent
					sub /
						<= idx 0
						<= btn $mws_ionui_button
							sub /
								<= txt2 \Vote
							event *
								click?val <=> rotate?val null
