$mws_ionui_demo_route $mol_view
	sub /
		<= IonRouter $mws_ionui_router
			sub <= getRoutes /
		<= IonApp $mws_ionui_app
			sub /
				<= IonMenuI $IonMenu
				<= RouterOutlet $RouterOutlet
$RouterOutlet $mws_ionui_routeroutlet
	attr *
		^
		id \outlet
$IonMenu $mws_ionui_menu
	attr *
		^
		content-id \outlet
	sub /
		<= IonHeader $mws_ionui_header
			sub /
				<= IonToolbar $mws_ionui_toolbar
					sub /
						<= IonTitle $mws_ionui_title
							sub /
								<= MenuTitleText \Menu
		<= MenuContent $mws_ionui_content
			sub /
				<= IonListHeader $mws_ionui_listheader
					sub /
						<= ilh \Navigation
				<= IonMenuToggle $mws_ionui_menutoggle
					sub /
						<= IonItem $mws_ionui_item
							attr *
								button \true
								href \/
							sub /
								<= ic1 $mws_ionui_icon
									attr *
										slot \start
										name \home
								<= il1 $mws_ionui_label
									sub /
										<= hl \Home
				<= IonMenuToggle3 $mws_ionui_menutoggle
					sub /
						<= IonItem3 $mws_ionui_item
							attr *
								button \true
								href \virtual
							sub /
								<= ic3 $mws_ionui_icon
									attr *
										slot \start
										name \logo-octocat
								<= il3 $mws_ionui_label
									sub /
										<= hl3 \Foto feed
