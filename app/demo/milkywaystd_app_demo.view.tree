$mws_app_demo $mol_app_demo
	Menu <= mws_app_demo_menu_factory null
	menu_items /any
		<= p1 *
			label \Misc
			tags /
				\crud
		<= p2 *
			label \Ui
			tags /
				\scroll
				\menu
		<= p3 *
			label \Ionic
			tags /
				\ionic
		<= p4 *
			label \Form validator
			tags /
				\form
				
$mws_app_demo_menu_tree $mol_app_demo_menu
	title \$milkywaystd examples
	Body $mol_scroll
		sub /
			<= List $mol_list rows /
				<= Filter $mol_search
					query?val <=> filter?val \
			<= menu $mws_ui_treemenu
				items <= tree_menu_items /
				filter <= filter
